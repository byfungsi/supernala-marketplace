{
  "name": "@supernala/marketplace",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm --filter @supernala/marketplace-infra typecheck && pnpm test",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --type-aware --type-check --deny-warnings",
    "marketplace": "tsx src/cli.ts",
    "release": "tsx src/release-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "effect": "catalog:",
    "fflate": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.5"
}
