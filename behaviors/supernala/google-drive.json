{
  "schemaVersion": 1,
  "plugin": "supernala-public:supernala:google-drive",
  "revision": 2,
  "failures": {
    "signals": {
      "messageTemplates": ["Google Drive request failed with status {status}"]
    },
    "rules": [
      {
        "kind": "auth_expired",
        "messagePrefix": ["Google Drive rejected the connection (401)"]
      },
      {
        "kind": "permission_denied",
        "messagePrefix": ["The Google Drive API is not enabled in the Google Cloud project"],
        "fix": "owner",
        "action": "report"
      },
      {
        "kind": "permission_denied",
        "messagePrefix": ["Google Drive lacks permission for this"]
      },
      {
        "kind": "not_found",
        "messagePrefix": ["Google Drive found nothing with that id"]
      },
      {
        "kind": "rate_limited",
        "messagePrefix": ["Google Drive is rate limited by Google"]
      },
      {
        "kind": "transient",
        "messagePrefix": ["Google Drive could not reach Google"]
      },
      {
        "kind": "transient",
        "httpStatus": [500, 502, 503, 504]
      }
    ],
    "kinds": {
      "auth_expired": {
        "fix": "auto",
        "action": "refresh_token"
      },
      "auth_revoked": {
        "fix": "owner",
        "action": "reconnect"
      },
      "permission_denied": {
        "fix": "owner",
        "action": "reconnect"
      },
      "rate_limited": {
        "fix": "auto",
        "action": "backoff"
      },
      "transient": {
        "fix": "auto",
        "action": "retry"
      },
      "not_found": {
        "fix": "none",
        "action": "none"
      }
    }
  },
  "observe": [
    {
      "from": "google-drive.search_files",
      "entity": "file",
      "items": "$.files[*]",
      "key": "$.fileId",
      "time": "$.modifiedTime",
      "keep": ["name", "mimeType", "modifiedTime", "url", "owners", "shared", "parentIds"]
    },
    {
      "from": "google-drive.list_folder",
      "entity": "file",
      "items": "$.files[*]",
      "key": "$.fileId",
      "time": "$.modifiedTime",
      "keep": ["name", "mimeType", "modifiedTime", "url", "owners", "shared", "parentIds"]
    }
  ],
  "sources": [
    {
      "id": "changed-files",
      "kind": "poll",
      "tool": "google-drive.search_files",
      "args": {
        "pageSize": 25
      },
      "intervalMinutes": 60,
      "items": "$.files[*]",
      "key": "$.fileId",
      "cursor": {
        "path": "$.modifiedTime",
        "arg": "modifiedAfter"
      }
    }
  ]
}
