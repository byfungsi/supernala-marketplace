{
  "schemaVersion": 1,
  "plugin": "supernala-public:supernala:jev",
  "revision": 1,
  "failures": {
    "rules": [
      {
        "kind": "auth_revoked",
        "httpStatus": [401]
      },
      {
        "kind": "quota_exceeded",
        "httpStatus": [402]
      },
      {
        "kind": "permission_denied",
        "httpStatus": [403]
      },
      {
        "kind": "rate_limited",
        "httpStatus": [429]
      },
      {
        "kind": "transient",
        "httpStatus": [500, 502, 503, 504]
      }
    ],
    "kinds": {
      "auth_revoked": {
        "fix": "owner",
        "action": "reconnect"
      },
      "quota_exceeded": {
        "fix": "owner",
        "action": "report"
      },
      "permission_denied": {
        "fix": "owner",
        "action": "report"
      },
      "rate_limited": {
        "fix": "auto",
        "action": "backoff"
      },
      "transient": {
        "fix": "auto",
        "action": "retry"
      }
    }
  }
}
