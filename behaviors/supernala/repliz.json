{
  "schemaVersion": 1,
  "plugin": "supernala-public:supernala:repliz",
  "revision": 1,
  "followUps": [
    {
      "id": "schedule-outcome",
      "after": {
        "tool": "repliz.create_schedule",
        "outcome": "succeeded"
      },
      "watch": {
        "tool": "repliz.get_schedule",
        "args": {
          "scheduleId": "$result._id"
        },
        "checkAt": ["+1h", "+1d", "+3d"],
        "stopAfter": "+7d"
      },
      "judge": {
        "classify": {
          "name": "status",
          "options": ["waiting", "processing", "published", "failed"]
        },
        "yesNo": {
          "name": "owner_should_know",
          "question": "Would the Owner want to hear about this now?"
        }
      },
      "wakeWhen": "status = failed or owner_should_know = yes",
      "instruction": "Say whether the scheduled post went out; if it failed, give the reason and suggest one fix."
    }
  ],
  "failures": {
    "rules": [
      {
        "kind": "auth_expired",
        "httpStatus": [401]
      },
      {
        "kind": "permission_denied",
        "httpStatus": [403]
      },
      {
        "kind": "not_found",
        "httpStatus": [404]
      },
      {
        "kind": "rate_limited",
        "httpStatus": [429]
      },
      {
        "kind": "transient",
        "httpStatus": [500, 502, 503, 504]
      }
    ],
    "kinds": {
      "auth_expired": {
        "fix": "auto",
        "action": "refresh_token"
      },
      "auth_revoked": {
        "fix": "owner",
        "action": "reconnect"
      },
      "permission_denied": {
        "fix": "owner",
        "action": "reconnect"
      },
      "rate_limited": {
        "fix": "auto",
        "action": "backoff"
      },
      "transient": {
        "fix": "auto",
        "action": "retry"
      },
      "not_found": {
        "fix": "none",
        "action": "none"
      }
    }
  },
  "observe": [
    {
      "from": "repliz.list_comments",
      "entity": "comment",
      "items": "$.docs[*]",
      "key": "$._id",
      "time": "$.createdAt",
      "keep": ["accountId", "status", "text", "createdAt"],
      "describe": {
        "classify": {
          "name": "kind",
          "options": ["praise", "question", "complaint", "spam", "other"]
        },
        "yesNo": {
          "name": "needs_reply",
          "question": "Does this comment need a reply from the Owner?"
        }
      }
    }
  ],
  "watchables": [
    {
      "id": "comments",
      "label": "Comments in my Repliz inbox",
      "tool": "repliz.list_comments",
      "params": {
        "status": {
          "type": "enum",
          "values": ["pending", "resolved", "ignored"],
          "label": "Comment status"
        },
        "search": {
          "type": "string",
          "label": "Text to search for in comments"
        }
      },
      "args": {
        "status": "$param.status",
        "search": "$param.search",
        "limit": 50
      },
      "items": "$.docs[*]",
      "key": "$._id",
      "fields": {
        "account_id": {
          "path": "$.accountId",
          "type": "string"
        },
        "status": {
          "path": "$.status",
          "type": "enum",
          "values": ["pending", "resolved", "ignored"]
        },
        "created": {
          "path": "$.createdAt",
          "type": "string"
        }
      }
    },
    {
      "id": "chats",
      "label": "Direct-message conversations",
      "tool": "repliz.list_chats",
      "params": {
        "status": {
          "type": "enum",
          "values": ["unread", "unreplied"],
          "label": "Chat status"
        }
      },
      "args": {
        "status": "$param.status",
        "limit": 50
      },
      "items": "$.docs[*]",
      "key": "$._id",
      "fields": {
        "account_id": {
          "path": "$.accountId",
          "type": "string"
        },
        "updated": {
          "path": "$.updatedAt",
          "type": "string"
        }
      }
    },
    {
      "id": "schedules",
      "label": "Scheduled and published posts, by status",
      "tool": "repliz.list_schedules",
      "params": {
        "status": {
          "type": "enum",
          "values": ["pending", "process", "error", "success"],
          "label": "Post status"
        }
      },
      "args": {
        "status": "$param.status",
        "limit": 50
      },
      "items": "$.docs[*]",
      "key": "$._id",
      "fields": {
        "account_id": {
          "path": "$.accountId",
          "type": "string"
        },
        "status": {
          "path": "$.status",
          "type": "enum",
          "values": ["pending", "process", "error", "success"]
        },
        "schedule_at": {
          "path": "$.scheduleAt",
          "type": "string"
        }
      }
    }
  ],
  "profile": {
    "steps": [],
    "defaultWatches": [
      {
        "id": "schedule-failed",
        "watchable": "schedules",
        "args": {
          "status": "error"
        },
        "condition": {
          "kind": "new-item"
        },
        "notify": "A post you scheduled in Repliz failed to publish."
      }
    ],
    "suggestedWatches": [
      {
        "id": "pending-comment",
        "watchable": "comments",
        "label": "Tell me when a new comment is waiting in my Repliz inbox",
        "args": {
          "status": "pending"
        },
        "condition": {
          "kind": "new-item"
        },
        "notify": "A new comment is waiting in Repliz"
      },
      {
        "id": "unreplied-chat",
        "watchable": "chats",
        "label": "Tell me when a new direct message is waiting for a reply",
        "args": {
          "status": "unreplied"
        },
        "condition": {
          "kind": "new-item"
        },
        "notify": "A new direct message is waiting for your reply"
      }
    ]
  }
}
