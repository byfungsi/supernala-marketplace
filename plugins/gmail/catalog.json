{
  "id": "gmail-catalog-v3",
  "schemaVersion": 1,
  "tools": [
    {
      "id": "gmail.search_messages",
      "mcpName": "search_messages",
      "title": "Search messages",
      "description": "Search message identities in the connected Gmail mailbox without reading bodies",
      "classification": "read",
      "defaultPolicy": "require-approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "minLength": 1, "maxLength": 500 },
          "maxResults": { "type": "integer", "minimum": 1, "maximum": 25 },
          "pageToken": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "required": ["query"],
        "additionalProperties": false
      },
      "maximumOutputBytes": 262144
    },
    {
      "id": "gmail.get_message",
      "mcpName": "get_message",
      "title": "Get message",
      "description": "Read one message as bounded plain text and inert metadata",
      "classification": "read",
      "defaultPolicy": "require-approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "required": ["messageId"],
        "additionalProperties": false
      },
      "maximumOutputBytes": 262144
    },
    {
      "id": "gmail.list_drafts",
      "mcpName": "list_drafts",
      "title": "List drafts",
      "description": "List draft identities in the connected Gmail mailbox without reading bodies",
      "classification": "read",
      "defaultPolicy": "require-approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "maxResults": { "type": "integer", "minimum": 1, "maximum": 25 },
          "pageToken": { "type": "string", "minLength": 1, "maxLength": 2048 }
        },
        "additionalProperties": false
      },
      "maximumOutputBytes": 262144
    },
    {
      "id": "gmail.get_draft",
      "mcpName": "get_draft",
      "title": "Get draft",
      "description": "Read one draft as bounded plain text and inert metadata",
      "classification": "read",
      "defaultPolicy": "require-approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "draftId": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "required": ["draftId"],
        "additionalProperties": false
      },
      "maximumOutputBytes": 262144
    },
    {
      "id": "gmail.send_message",
      "mcpName": "send_message",
      "title": "Send message",
      "description": "Send one plain-text email from the connected Gmail account; failed dispatch may be ambiguous",
      "classification": "write",
      "defaultPolicy": "require-approval",
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "to": {
            "type": "string",
            "minLength": 3,
            "maxLength": 254
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 998
          },
          "bodyText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "required": ["to", "subject", "bodyText"],
        "additionalProperties": false
      },
      "maximumOutputBytes": 16384
    }
  ]
}
