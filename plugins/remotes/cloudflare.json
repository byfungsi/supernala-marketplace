    "tools": [
      {
        "id": "cloudflare.docs",
        "mcpName": "docs",
        "title": "Search Cloudflare Docs",
        "description": "Search the Cloudflare documentation for any question about Cloudflare products or features, including Workers, Pages, R2, D1, KV, Durable Objects, Queues, Workers AI, Vectorize, Zero Trust, CDN, Cache, DNS, and account or billing. Returns semantically similar documentation chunks.",
        "classification": "read",
        "defaultPolicy": "allow",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "query": {
              "type": "string",
              "description": "Cloudflare documentation search query"
            }
          },
          "required": ["query"]
        },
        "maximumOutputBytes": 262144
      },
      {
        "id": "cloudflare.search",
        "mcpName": "search",
        "title": "Search Cloudflare API Spec",
        "description": "Search the Cloudflare OpenAPI spec (all $refs resolved inline) to find endpoints before calling execute. code is a JavaScript async arrow function over `spec: { paths: Record<string, PathItem> }`, where each PathItem maps get/post/put/patch/delete to OperationInfo { summary, description, tags, parameters, requestBody, responses, \"x-api-token-group\" }. x-api-token-group lists the permissions an endpoint accepts; OAuth scopes have the same names. Example: async () => spec.paths['/accounts/{account_id}/workers/scripts']?.get?.parameters",
        "classification": "read",
        "defaultPolicy": "allow",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "code": {
              "type": "string",
              "description": "JavaScript async arrow function to search the OpenAPI spec"
            }
          },
          "required": ["code"]
        },
        "maximumOutputBytes": 262144
      },
      {
        "id": "cloudflare.execute",
        "mcpName": "execute",
        "title": "Run Cloudflare API Code",
        "description": "Run JavaScript that can read, create, update, or delete resources through the Cloudflare API. Use search first to find endpoints. code is an async arrow function that returns its result and calls `cloudflare.request({ method, path, query?, body?, contentType?, rawBody? })`, resolving to { success, status, result, errors, messages, result_info? }. `accountId` is the account_id argument, or the session's only account; when the connection can reach several accounts, call GET /accounts and pass account_id. A failed request throws an Error naming the method, path, HTTP status, Cloudflare errors, and for 401/403 the missing permission.",
        "classification": "destructive",
        "defaultPolicy": "require-approval",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "code": {
              "type": "string",
              "description": "JavaScript async arrow function to execute"
            },
            "account_id": {
              "description": "Cloudflare account ID to run against. Optional when the session is authorized for exactly one account, and for account-independent calls such as GET /accounts.",
              "type": "string"
            }
          },
          "required": ["code"]
        },
        "maximumOutputBytes": 262144
      },
      {
        "id": "cloudflare.whoami",
        "mcpName": "whoami",
        "title": "Current Cloudflare Identity",
        "description": "Return the Cloudflare user or account that this connection is authenticated as. Takes no arguments. The id is stable across token refresh, reconnection and permission changes.",
        "classification": "read",
        "defaultPolicy": "allow",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {},
          "additionalProperties": false
        },
        "maximumOutputBytes": 65536
      }
    ]
  },
