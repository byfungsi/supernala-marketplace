{
  "display_information": {
    "name": "Supernala",
    "description": "Connect Supernala agents to Slack through the Slack Web API"
  },
  "oauth_config": {
    "redirect_urls": ["https://app.supernala.com/v1/plugins/oauth/callback"],
    "scopes": {
      "user": [
        "canvases:read",
        "canvases:write",
        "channels:history",
        "channels:read",
        "channels:write",
        "chat:write",
        "emoji:read",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "groups:write",
        "im:history",
        "im:read",
        "im:write",
        "lists:read",
        "lists:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "reactions:read",
        "reactions:write",
        "search:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": false,
    "token_rotation_enabled": true
  }
}
