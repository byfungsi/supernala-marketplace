    {
      "id": "slack.slack_read_channel",
      "mcpName": "slack_read_channel",
      "title": "read channel",
      "description": "Read at most 15 messages from one channel page. Unapproved commercial apps are limited to one request per minute per workspace for this method. Honor retryAfterSeconds; never loop past rate limits.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[CDG][A-Z0-9]+$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "oldest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[0-9]{1,20}\\.[0-9]{1,10}$"
          },
          "latest": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[0-9]{1,20}\\.[0-9]{1,10}$"
          },
          "inclusive": {
            "type": "boolean"
          }
        },
        "required": ["channel_id"],
        "additionalProperties": false
      },
      "classification": "read",
      "defaultPolicy": "require-approval",
      "maximumOutputBytes": 262144
    },
