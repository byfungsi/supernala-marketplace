    {
      "id": "slack.slack_search_channels",
      "mcpName": "slack_search_channels",
      "title": "search channels",
      "description": "Find accessible Slack channels by name on one page. Continue with next_cursor even when a filtered page is empty; this is not semantic search.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "keywords": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "types": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "exclude_archived": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "classification": "read",
      "defaultPolicy": "require-approval",
      "maximumOutputBytes": 262144
    },
