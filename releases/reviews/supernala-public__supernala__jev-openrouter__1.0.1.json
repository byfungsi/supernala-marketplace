    "tools": [
      {
        "id": "jev.ask",
        "classification": "read",
        "defaultPolicy": "allow",
        "inputSchema": {
          "type": "object",
          "properties": {
            "body": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string",
                  "enum": ["typesafe/jev-latest", "typesafe/jev-1.14"],
                  "description": "Jev model; `typesafe/jev-latest` follows the newest release."
                },
                "state": {
                  "type": ["string", "object", "array"],
                  "description": "The content every question refers to: text, or a JSON object or array of related context such as {\"subject\":...,\"message\":...}. Keep it focused; long state lowers accuracy."
                },
                "questions": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["choice", "score", "noul"],
                        "description": "Question type."
                      },
                      "instructions": {
                        "type": "string",
                        "maxLength": 8000,
                        "description": "What to decide, rate or evaluate."
                      },
                      "criteria": {
                        "type": ["object", "array"],
                        "description": "choice: {option name: when it applies}. score: [lowest level, ..., highest level]. noul: optional {\"true\": ..., \"false\": ...}."
                      }
                    },
                    "required": ["type"],
                    "additionalProperties": false
                  },
                  "description": "Questions about `state`, each under a name you choose (letters, digits, underscores); answers come back under the same names. Ask several at once: it costs no more and is just as fast. Types: `choice` picks one option; `criteria` maps each option name to when it applies, e.g. {\"billing\":\"Charges, refunds, invoices\",\"bug\":\"Something is broken\"}; the answer has `choice`, `confidence` and `probabilities` per option. `score` rates against ordered levels; `criteria` is a list of 1-10 level descriptions from lowest (0) up; the answer has the expected `score`, `confidence`, `legend` and `probabilities` per level. `noul` is a yes/no question or statement; optional `criteria` {\"true\":\"what counts as yes\",\"false\":\"what counts as no\"}; the answer `noul` is the probability of yes (0-1). Jev returns typed answers only; it never writes text."
                }
              },
              "required": ["model", "state", "questions"],
              "additionalProperties": false
            }
          },
          "required": ["body"],
          "additionalProperties": false
        }
      }
    ],
